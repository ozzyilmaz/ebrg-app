{
  "expo": {
    "name": "EbrG",
    "slug": "ebrg",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0e13",
    "ios": {
      "bundleIdentifier": "com.appfellas.ebrg",
      "supportsTablet": true,
      "requireFullScreen": true,
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSMicrophoneUsageDescription": "Takım arkadaşlarınla sesli konuşmak için mikrofon kullanılır."
      }
    },
    "android": {
      "package": "com.appfellas.ebrg",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0b0e13",
        "foregroundImage": "./assets/adaptive.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0e13",
          "image": "./assets/splash.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71de85c7-9eb7-4df5-9812-fef14ac88fbf"
      }
    },
    "owner": "ozzyko"
  }
}